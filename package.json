{
  "name": "paper-moments-site",
  "version": "0.1.0",
  "private": true,
  "description": "一个以纸张手账风格记录日常说说的 Hexo 站点。",
  "packageManager": "pnpm@10.30.3",
  "hexo": {
    "version": "7.3.0"
  },
  "scripts": {
    "clean": "hexo clean",
    "build": "hexo clean && hexo generate",
    "dev": "cross-env HEXO_OFFLINE_SKIP=1 hexo server --port 4100",
    "check": "hexo generate",
    "start": "cross-env HEXO_OFFLINE_SKIP=1 hexo clean && cross-env HEXO_OFFLINE_SKIP=1 hexo generate && cross-env HEXO_OFFLINE_SKIP=1 hexo server --port 4100"
  },
  "dependencies": {
    "hexo": "^7.3.0",
    "hexo-bb-channel": "^0.2.1",
    "hexo-offline": "^4.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-server": "^3.0.0",
    "pjax": "^0.2.8"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
